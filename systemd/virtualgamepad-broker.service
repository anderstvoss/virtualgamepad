[Unit]
Description=VirtualGamepad privileged realization broker
Requires=virtualgamepad-broker.socket
After=virtualgamepad-broker.socket

[Service]
Type=exec
ExecStart=/usr/libexec/virtualgamepad/virtualgamepad-broker --socket-activation --config /etc/virtualgamepad/broker.conf
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/virtualgamepad /sys/kernel/config/usb_gadget
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_MODULE CAP_NET_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_MODULE CAP_NET_ADMIN
SystemCallArchitectures=native
Restart=on-failure

[Install]
WantedBy=multi-user.target
