[Unit]
Description=VirtualGamepad privileged realization broker
Requires=virtualgamepad-broker.socket
After=virtualgamepad-broker.socket

[Service]
Type=exec
ExecStart=/usr/libexec/virtualgamepad/virtualgamepad-broker --socket-activation --config /etc/virtualgamepad/broker.conf
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/virtualgamepad /run/virtualgamepad-state /sys/kernel/config/usb_gadget
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
# CAP_SYS_ADMIN removal is pending the documented live reduced-capability gate.
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=
ProtectKernelModules=true
SystemCallArchitectures=native
Restart=on-failure

[Install]
WantedBy=multi-user.target
