[Unit]
Description=VirtualGamepad privileged broker socket

[Socket]
ListenStream=/run/virtualgamepad/broker.sock
SocketUser=root
SocketGroup=virtualgamepad
SocketMode=0660
# The socket itself is group-restricted. The parent needs execute-only access
# for that group to reach its known fixed pathname; it remains non-listable.
DirectoryMode=0711
RemoveOnStop=true

[Install]
WantedBy=sockets.target
